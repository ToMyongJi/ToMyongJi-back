{
  "id": null,
  "uid": "tomyongji-red",
  "title": "ToMyongJi - RED (API)",
  "description": "RED 프레임워크: 주요 API 4개(로그인, 영수증 페이징 조회, 영수증 단건 조회, 단과대/학생회 목록 조회)의 Rate/Errors/Duration. 성능 튜닝 전후 비교용 baseline.",
  "tags": [ "tomyongji", "red", "baseline" ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "endpoints",
        "type": "textbox",
        "label": "대상 API (regex)",
        "current": {
          "text": "^(/api/users/login|/api/receipt/club/{clubId}/paging|/api/receipt/{receiptId}|/api/collegesAndClubs)$",
          "value": "^(/api/users/login|/api/receipt/club/{clubId}/paging|/api/receipt/{receiptId}|/api/collegesAndClubs)$"
        },
        "query": "^(/api/users/login|/api/receipt/club/{clubId}/paging|/api/receipt/{receiptId}|/api/collegesAndClubs)$"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "요청량 (Rate, req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{uri=~\"$endpoints\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "응답시간 p50",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"$endpoints\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "응답시간 p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"$endpoints\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "응답시간 p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~\"$endpoints\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "에러율 (5xx, %)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"$endpoints\",status=~\"5..\"}[$__rate_interval])) or 0 * sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"$endpoints\"}[$__rate_interval]))) / sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"$endpoints\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    }
  ]
}
